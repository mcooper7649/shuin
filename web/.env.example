# Server-only. Pinata JWT with pinFileToIPFS/upload scope. Never prefix with NEXT_PUBLIC_.
PINATA_JWT=
# Gateway used to display IPFS content (your dedicated Pinata gateway is faster).
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
# Local dev without a Pinata JWT: uploads are kept in memory; point the gateway at the dev store:
# NEXT_PUBLIC_IPFS_GATEWAY=http://localhost:3000/api/ipfs/
# Shared "Shuin Open Book" collection address (same on every chain when deployed by the same key).
NEXT_PUBLIC_OPEN_BOOK=
# Optional: WalletConnect / Reown project id, enables the WalletConnect QR option.
NEXT_PUBLIC_WC_PROJECT_ID=
# Optional: set to 1 to show mainnets in the chain picker (testnets only by default).
NEXT_PUBLIC_ENABLE_MAINNETS=
# Optional RPC overrides, by chain id: NEXT_PUBLIC_RPC_11155111=https://...
